# Firebase project config
FIREBASE_PROJECT_ID=rentvault
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@rentvault.iam.gserviceaccount.com

# Nomba API environment (test or live)
NOMBA_ENV=test

# Nomba account structure
NOMBA_PARENT_ACCOUNT_ID=your_parent_account_id
NOMBA_SUB_ACCOUNT_ID=your_sub_account_id

# Nomba LIVE credentials
NOMBA_LIVE_CLIENT_ID=your_live_client_id
NOMBA_LIVE_PRIVATE_KEY=your_live_private_key

# Nomba TEST credentials
NOMBA_TEST_CLIENT_ID=your_test_client_id
NOMBA_TEST_PRIVATE_KEY=your_test_private_key

# Nomba webhook secret (for signature validation)
NOMBA_WEBHOOK_SECRET=your_nomba_webhook_secret

# Nomba API base URL (sandbox vs production)
NOMBA_BASE_URL=https://api.sandbox.nomba.com/v1

# Webhook base URL (for local dev use ngrok or Firebase function URL)
NOMBA_WEBHOOK_BASE_URL=http://localhost:5001/rentvault/us-central1

# Platform account
PLATFORM_NOMBA_ACCOUNT_ID=your_platform_nomba_account_id

# Verification timeout in hours (default 48)
VERIFICATION_TIMEOUT_HOURS=48
