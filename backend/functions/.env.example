# Firebase project config
FIREBASE_PROJECT_ID=rentvault
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@rentvault.iam.gserviceaccount.com

# Nomba API environment (test or live)
NOMBA_ENV=test

# Nomba account structure
NOMBA_PARENT_ACCOUNT_ID=your_parent_account_id
NOMBA_SUB_ACCOUNT_ID=your_sub_account_id

# Nomba LIVE credentials
NOMBA_LIVE_CLIENT_ID=your_live_client_id
NOMBA_LIVE_PRIVATE_KEY=your_live_private_key

# Nomba TEST credentials
NOMBA_TEST_CLIENT_ID=your_test_client_id
NOMBA_TEST_PRIVATE_KEY=your_test_private_key

# Nomba webhook secret (for signature validation)
NOMBA_WEBHOOK_SECRET=your_nomba_webhook_secret

# Nomba API base URL (sandbox vs production) - NOTE: no /v1 suffix, and the
# sandbox host is "sandbox.nomba.com", not "api.sandbox.nomba.com"
NOMBA_BASE_URL=https://sandbox.nomba.com

# Base URL (+ /api path) used to build the checkout callback URL - the
# webhook URL itself is configured separately in the Nomba dashboard
# (Developer -> Webhook Setup), not sent via the API
NOMBA_WEBHOOK_BASE_URL=http://localhost:3001/api

# Monnify API environment (test or live)
MONNIFY_ENV=test

# Monnify merchant contract code (from your Monnify dashboard)
MONNIFY_CONTRACT_CODE=your_contract_code

# Monnify LIVE credentials
MONNIFY_LIVE_API_KEY=your_live_api_key
MONNIFY_LIVE_SECRET_KEY=your_live_secret_key

# Monnify TEST credentials
MONNIFY_TEST_API_KEY=your_test_api_key
MONNIFY_TEST_SECRET_KEY=your_test_secret_key

# Monnify API base URL (sandbox vs production)
MONNIFY_BASE_URL=https://sandbox.monnify.com

# Wallet account number disbursements/transfers are debited from
MONNIFY_SOURCE_ACCOUNT_NUMBER=your_monnify_wallet_account_number

# Verification timeout in hours (default 48)
VERIFICATION_TIMEOUT_HOURS=48

# Document storage (Supabase Storage - Firebase Storage requires the paid
# Blaze plan even to stay within its free tier). Bucket is "documents".
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Internal secret protecting /api/internal/check-timeouts from being called
# by anyone but your own cron job (see backend/server/src/middleware.ts)
INTERNAL_CRON_SECRET=your_internal_cron_secret
