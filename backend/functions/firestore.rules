rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: get user role from the users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper: check if the user has a specific role
    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    // Helper: tenant verification fields are review-controlled and must only
    // ever change via the tenantVerification* Cloud Functions (Admin SDK,
    // which bypasses these rules entirely) - never by a direct client write.
    function verificationFieldsUnchanged() {
      return request.resource.data.get('verificationStatus', 'unverified') == resource.data.get('verificationStatus', 'unverified') &&
        request.resource.data.get('verificationDocuments', null) == resource.data.get('verificationDocuments', null) &&
        request.resource.data.get('verificationRejectionReason', null) == resource.data.get('verificationRejectionReason', null);
    }

    // Users collection
    match /users/{uid} {
      allow read: if isAuthenticated();
      // Self-serve signup may only ever create a tenant or landlord account -
      // admin/agent accounts must be provisioned out-of-band (Admin SDK or
      // Firestore console), never chosen by the client on account creation.
      allow create: if isAuthenticated() && request.auth.uid == uid &&
        request.resource.data.role in ['tenant', 'landlord'];
      // Role is set once at account creation and is permanently locked after that -
      // updates may never change it, even by the account owner. This prevents
      // client-side privilege escalation (e.g. a tenant granting themselves admin
      // or self-approving their own tenant verification).
      allow update: if isAuthenticated() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        verificationFieldsUnchanged();
      allow delete: if false; // Never delete users
    }

    // Listings collection - public read, authenticated write
    match /listings/{listingId} {
      allow read: if true; // Public read for search without auth
      allow create: if isAuthenticated() && hasRole('landlord');
      allow update: if isAuthenticated() && (
        hasRole('admin') ||
        (hasRole('landlord') && resource.data.landlordUid == request.auth.uid)
      );
      allow delete: if hasRole('admin');
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Tenant can read own transactions, landlord/agent can read associated, admin can read all
      allow read: if isAuthenticated() && (
        hasRole('admin') ||
        resource.data.tenantUid == request.auth.uid ||
        resource.data.landlordUid == request.auth.uid ||
        resource.data.agentUid == request.auth.uid
      );
      // Only Cloud Functions (admin SDK) should write to transactions
      allow write: if false;
    }

    // SplitConfigs collection
    match /splitConfigs/{configId} {
      allow read: if true; // Public read for listing display
      allow write: if hasRole('admin'); // Only admins can manage split configs
    }

    // AuditLogs collection
    match /auditLogs/{logId} {
      // Admins can read audit logs
      allow read: if hasRole('admin');
      // Only Cloud Functions should write audit logs
      allow write: if false;
    }

    // Webhook events (deduplication)
    match /webhookEvents/{eventId} {
      allow read: if hasRole('admin');
      allow write: if false; // Only Cloud Functions
    }
  }
}
